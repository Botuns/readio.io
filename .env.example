# Copy to .env.local and fill in the two credentials from the hackathon spec PDF.
# .env.local is gitignored. Never commit real values.

# Path the browser calls. It is proxied to API_PROXY_TARGET (see vite.config.ts and vercel.json).
VITE_API_BASE_URL=/api/jobs

# Value of the MyAuthorizationx header.
VITE_API_CUSTOM_AUTH=replace-with-MyAuthorizationx-value

# Base64 part of the Authorization header (without the "Basic " prefix).
VITE_API_BASIC_AUTH=replace-with-base64-basic-credentials

# Default data source: "live" or "mock". The in-app toggle overrides it per browser.
VITE_DATA_SOURCE=live

# Upstream API the dev and preview proxy forwards to. Read by vite.config.ts only.
API_PROXY_TARGET=https://readie001.uc.r.appspot.com/auth/recording/jobs

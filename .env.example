# Copy to .env.local. .env.local is gitignored. Never commit real values.

# Path the browser calls. It is proxied to API_PROXY_TARGET (see vite.config.ts and vercel.json).
VITE_API_BASE_URL=/api/jobs

# Value of the MyAuthorizationx header. The app adds it to every request;
# users are never asked for it. Required for live mode.
VITE_API_CUSTOM_AUTH=

# Optional. Base64 part of the Authorization header (without the "Basic " prefix).
# Leave empty to sign in with a username and password in the app instead.
VITE_API_BASIC_AUTH=

# Default data source: "live" or "mock". The in-app toggle overrides it per browser.
VITE_DATA_SOURCE=live

# Upstream API the dev and preview proxy forwards to. Read by vite.config.ts only.
API_PROXY_TARGET=https://readie001.uc.r.appspot.com/auth/recording/jobs

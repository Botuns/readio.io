{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm exec tsc -b && pnpm exec vite build --mode mock",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/jobs/:path*",
      "destination": "https://readie001.uc.r.appspot.com/auth/recording/jobs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/mockServiceWorker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
